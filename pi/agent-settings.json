{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Write", "Edit",
      "Bash(python3 tools/bench_local.py:*)",
      "Bash(python3 sim/*)",
      "Bash(bash pi/flash.sh:*)",
      "Bash(python3 pi/guard_check.py check)",
      "Bash(touch ~/peltier-state/PAUSE)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git switch -c agent/*)", "Bash(git push origin agent/*)", "Bash(gh pr create:*)", "Bash(gh pr list:*)"
