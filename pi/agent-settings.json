    "deny": [
      "Edit(tools/**)", "Write(tools/**)", "Edit(.github/**)", "Write(.github/**)",
      "Edit(AGENTS.md)", "Write(AGENTS.md)", "Edit(pi/**)", "Write(pi/**)",
      "Edit(.claude/**)", "Write(.claude/**)",
      "Bash(git push origin main:*)", "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin HEAD:main:*)",
      "Bash(sudo:*)", "Bash(rm:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(ssh:*)"
    ]
  }
}
